{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^db:generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "^db:generate",
        "db:generate"
      ]
    },
    "lint": {},
    "test": {
      "outputs": [],
      "dependsOn": [
        "^db:generate",
        "db:generate"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
