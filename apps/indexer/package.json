{
  "name": "@finance-os/indexer",
  "version": "0.0.0",
  "private": true,
  "description": "Long-running Stellar watcher that records Transactions",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "backfill": "tsx src/backfill.ts"
  },
  "dependencies": {
    "@finance-os/config": "workspace:*",
    "@finance-os/db": "workspace:*",
    "@finance-os/shared": "workspace:*",
    "@finance-os/stellar": "workspace:*",
    "bullmq": "^6.7.2",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "@testcontainers/postgresql": "12.2.1",
    "pino-pretty": "^13.2.0",
    "testcontainers": "12.2.1"
  }
}
