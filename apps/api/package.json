    "@finance-os/stellar": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "pino-pretty": "^13.2.0"
  }
