// Domain model — README §4. Every business record is scoped to an Organization.
// Money columns are Decimal(38,7): Stellar amounts have 7 decimal places.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  admin
  approver
  accountant
  viewer
}

enum StellarNetwork {
  testnet
  mainnet
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum PaymentRequestStatus {
  draft
  pending_approval
  approved
  submitted
  settled
  rejected
  failed
}

enum TransactionDirection {
  in
  out
}

enum TransactionStatus {
  success
  failed
}

enum OperationType {
  payment
  path_payment_strict_receive
  path_payment_strict_send
  claimable_balance_claim
  account_merge
  contract_transfer
}

enum MatchMethod {
  muxed
  memo
  contract_event
  manual
}

enum MemoType {
  none
  text
  id
  hash
  return
}

enum ApprovalDecision {
  approved
  rejected
}

enum ExportStatus {
  pending
  ready
  failed
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  wallets      WalletAddress[]
  memberships  Member[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

/// A Stellar address the user proved ownership of via a signed challenge.
/// Only public keys are stored — never secret keys (AGENTS.md #1).
model WalletAddress {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String   @unique
  verifiedAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_addresses")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]
  treasuryAccounts TreasuryAccount[]
  clients          Client[]
  invoices         Invoice[]
  invoiceLineItems InvoiceLineItem[]
  vendors          Vendor[]
  paymentRequests  PaymentRequest[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  paymentRequestsCreated PaymentRequest[] @relation("PaymentRequestCreator")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

/// A Stellar G-address the org controls, watched by the indexer.
model TreasuryAccount {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stellarAddress String
  label          String
  network        StellarNetwork
  /// Last processed Horizon paging token. Indexer resumes from here.
  indexerCursor  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  invoices       Invoice[]
  paymentRequests PaymentRequest[]

  @@unique([network, stellarAddress])
  @@index([organizationId])
  @@map("treasury_accounts")
}

model Client {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  /// Sender addresses previously seen paying this client's invoices (heuristic matching).
  knownAddresses String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invoices       Invoice[]

  @@index([organizationId])
  @@map("clients")
}

model Invoice {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @db.Uuid
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId          String          @db.Uuid
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Human number, e.g. INV-2026-0042. Unique per org.
  number            String
  assetCode         String
  assetIssuer       String?
  amount            Decimal         @db.Decimal(38, 7)
  amountPaid        Decimal         @default(0) @db.Decimal(38, 7)
  dueDate           DateTime        @db.Date
  status            InvoiceStatus   @default(draft)
  notes             String?
  sentAt            DateTime?
  paidAt            DateTime?
  voidedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  /// Treasury account the invoice is paid into (base G-address for the muxed reference).
  treasuryAccountId String          @db.Uuid
  treasuryAccount   TreasuryAccount @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  /// Globally unique numeric id used as the muxed-account id (uint64) — README §5.1.
  paymentRefId      BigInt          @unique @default(autoincrement())
  /// M... address derived from the treasury G-address + paymentRefId.
  muxedAddress      String?         @unique
  /// Memo fallback for wallets without muxed support (e.g. INV0042) — README §5.2.
  memo              String?
  /// Unguessable token for the unauthenticated payment page.
  publicToken       String          @unique
  lineItems         InvoiceLineItem[]

  @@unique([organizationId, number])
  @@unique([treasuryAccountId, memo])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([treasuryAccountId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String       @db.Uuid
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantity       Decimal      @db.Decimal(38, 7)
  unitPrice      Decimal      @db.Decimal(38, 7)
  amount         Decimal      @db.Decimal(38, 7)

  @@unique([invoiceId, position])
  @@index([organizationId])
  @@map("invoice_line_items")
}

model Vendor {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  /// Payout address (G... or M...).
  stellarAddress String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  /// Some exchanges require a memo on deposits.
  memoRequired   Boolean      @default(false)
  memo           String?
  memoType       MemoType     @default(none)
  paymentRequests PaymentRequest[]

  @@index([organizationId])
  @@map("vendors")
}

model PaymentRequest {
  id                String               @id @default(uuid(7)) @db.Uuid
  organizationId    String               @db.Uuid
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorId          String               @db.Uuid
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assetCode         String
  assetIssuer       String?
  amount            Decimal              @db.Decimal(38, 7)
  reason            String
  /// Attachment metadata: [{ name, url, contentType }].
  attachments       Json                 @default("[]")
  status            PaymentRequestStatus @default(draft)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdByMemberId String               @db.Uuid
  createdBy         Member               @relation("PaymentRequestCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  /// Account the payment is sent from.
  sourceTreasuryAccountId String          @db.Uuid
  sourceTreasuryAccount   TreasuryAccount @relation(fields: [sourceTreasuryAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([vendorId])
  @@map("payment_requests")
}
