// Domain model — README §4. Every business record is scoped to an Organization.
// Money columns are Decimal(38,7): Stellar amounts have 7 decimal places.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  admin
  approver
  accountant
  viewer
}

enum StellarNetwork {
  testnet
  mainnet
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum PaymentRequestStatus {
  draft
  pending_approval
  approved
  submitted
  settled
  rejected
  failed
}

enum TransactionDirection {
  in
  out
}

enum TransactionStatus {
  success
  failed
}

enum OperationType {
  payment
  path_payment_strict_receive
  path_payment_strict_send
  claimable_balance_claim
  account_merge
  contract_transfer
}

enum MatchMethod {
  muxed
  memo
  contract_event
  manual
}

enum MemoType {
  none
  text
  id
  hash
  return
}
