// Domain model — README §4. Every business record is scoped to an Organization.
// Money columns are Decimal(38,7): Stellar amounts have 7 decimal places.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  admin
  approver
  accountant
  viewer
}

enum StellarNetwork {
  testnet
  mainnet
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum PaymentRequestStatus {
  draft
  pending_approval
  approved
  submitted
  settled
  rejected
  failed
}

enum TransactionDirection {
  in
  out
}

enum TransactionStatus {
  success
  failed
}

enum OperationType {
  payment
  path_payment_strict_receive
  path_payment_strict_send
  claimable_balance_claim
  account_merge
  contract_transfer
}

enum MatchMethod {
  muxed
  memo
  contract_event
  manual
}

enum MemoType {
  none
  text
  id
  hash
  return
}

enum ApprovalDecision {
  approved
  rejected
}

enum ExportStatus {
  pending
  ready
  failed
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  wallets      WalletAddress[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

/// A Stellar address the user proved ownership of via a signed challenge.
/// Only public keys are stored — never secret keys (AGENTS.md #1).
model WalletAddress {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String   @unique
  verifiedAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_addresses")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}
